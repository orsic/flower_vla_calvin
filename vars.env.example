# Per-server environment config for run.sh (and, through it, podman compose).
#
# Copy this file to vars.env and fill in real values for this machine:
#   cp vars.env.example vars.env
#
# vars.env is gitignored — it's local, per-server config, not something to commit.
# run.sh loads it automatically if present. Format: one KEY=VALUE per line, no
# quotes needed, "#" starts a comment. Values already set in your shell environment
# take precedence over this file (so a one-off `SAVES_DIR=/tmp/x ./run.sh ...`
# still overrides it without editing anything here).

# HF model cache (mounted at /root/.cache/huggingface). Default: ~/.cache/huggingface
HF_HOME=/path/to/hf

# LeRobot datasets (mounted at /root/.cache/huggingface/lerobot). Default: $HF_HOME/lerobot
LEROBOT_HOME=/path/to/lerobot

# All outputs: checkpoints, norm-stats assets, wandb runs, eval videos (mounted at /saves).
SAVES_DIR=/path/to/saves

# Root data directory (parent of libero_hdf5/, future datasets, etc.).
# Default: <repo>/data — set to an SSD path to keep large data off the home partition.
DATA_DIR=/path/to/data

# Raw LIBERO .hdf5 demos, downloaded via `./run.sh download-data` (mounted read-only at
# /libero_hdf5). Derived from DATA_DIR; override here only if stored elsewhere.
LIBERO_HDF5_DIR=${DATA_DIR}/libero_hdf5

# GPU selector applied to every service via CUDA_VISIBLE_DEVICES (compose.yml).
# Eval uses this to decide how many GPUs to run in parallel; training uses -1 (all
# visible) for PyTorch Lightning. Set to the physical GPU IDs you want to target.
# Default "0" = single GPU (safe baseline). Examples:
#   CUDA_VISIBLE_DEVICES=0,1,2,3   →  4-GPU training; eval splits 10 tasks across 4 GPUs
#   CUDA_VISIBLE_DEVICES=2,3       →  use physical GPUs 2 & 3, leaving 0 & 1 free
CUDA_VISIBLE_DEVICES=0

# Optional: override the W&B API key instead of relying on ~/.config/wandb/api.key.
# WANDB_API_KEY=

# Optional: HuggingFace token, needed for gated models/datasets.
# HF_TOKEN=your-hf-token

# Optional: podman (cgroup) memory cap applied to every service (scripts/podman/compose.yml's
# `x-limits` anchor). If a training run leaks host RAM (e.g. an online-training config with
# cache_all_episodes=True — see gpu_video_decode in config.py), this makes the *container*
# get OOM-killed instead of crashing the whole machine. Defaults to 384g if unset, which
# protects nothing on any host with less RAM than that — always set this explicitly, to
# roughly 70-80% of this machine's physical RAM (leave headroom for the OS and any other
# processes/users on the box). Example for a 128GB host:
MEM_LIMIT=128g
