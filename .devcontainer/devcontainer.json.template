{
    "name": "FlowerVLA",
    // Generated by ./run.sh devenv — do not edit directly, edit devcontainer.json.template instead.
    "image": "localhost/flower-vla-eval:latest",
    "workspaceFolder": "/workspace",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "runArgs": [
        "--device=nvidia.com/gpu=all",
        "--shm-size=16g",
        "--cap-add=SYS_PTRACE"
    ],
    "mounts": [
        "source=@@HF_HOME@@,target=/root/.cache/huggingface,type=bind,consistency=cached",
        "source=@@SAVES_DIR@@,target=/saves,type=bind",
        "source=@@LIBERO_HDF5_DIR@@,target=/libero_hdf5,type=bind,readonly=true"
    ],
    "containerEnv": {
        "PYTHONPATH": "/workspace/LIBERO:/workspace",
        "MUJOCO_GL": "egl",
        "PYOPENGL_PLATFORM": "egl",
        "HYDRA_FULL_ERROR": "1",
        "WANDB_MODE": "disabled",
        "HF_HOME": "/root/.cache/huggingface",
        "CUDA_DEVICE_ORDER": "PCI_BUS_ID"
    },
    "postStartCommand": "bash /workspace/.devcontainer/setup.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/bin/python",
                "python.analysis.extraPaths": ["/workspace", "/workspace/LIBERO"]
            }
        }
    }
}
